# QuizLab AI Roadmap server keys (NEVER commit the real .env).
# At least one key is required for /api/roadmap. Multiple keys enable failover.
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=

# Optional: override the OpenAI-compatible provider and model.
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Optional: server port used when serving the built app (npm run server).
# PORT=4317